<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pantai</title>

    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: #4b6361;
        }

        /* HEADER */
        header {
            background-color: #4b6361;
            color: white;
            padding: 15px 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        header h1 {
            font-size: 20px;
            margin: 0;
        }

        /* Tombol kembali */
        .back-btn {
            position: absolute;
            left: 10px;
            font-size: 25px;
            font-weight: bold;
            color: white;
            text-decoration: none;
        }

        /* Container putih tengah */
        .container {
            width: 60%;
            margin: 30px auto;
            background: white;
            border-radius: 15px;
            padding: 25px;
        }

        /*  SPACE + LOGO DI ATAS CARD AMED  */
        .top-logo-container {
            width: 100%;
            height: 60px;
            /* space kosong */
            position: relative;
            margin-bottom: -10px;
            /* biar card naik sedikit */
        }

        .top-logo-container img {
            position: absolute;
            right: 20px;
            top: 5px;
            height: 40px;
        }

        /* space */

        /* Kartu destinasi */
        .card {
            background-color: white;
            border-radius: 15px;
            width: 95%;
            box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.15);
            padding: 30px;
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }

        .card img {
            width: 30%;
            height: 180px;
            border-radius: 10px;
            object-fit: cover;
        }

        .card-content {
            width: 45%;
        }

        .card-content h2 {
            margin: 0;
            color: #3a5f5c;
        }

        .card-content p {
            margin: 20px 0;
            font-size: 14px;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .container {
                width: 85%;
                padding: 20px;
            }

            .card {
                flex-direction: column;
                text-align: center;
                padding: 20px;
            }

            .card img {
                width: 100%;
                height: 200px;
            }

            .card-content {
                width: 100%;
            }

            header h1 {
                font-size: 18px;
            }
        }

        @media (max-width: 480px) {
            header h1 {
                font-size: 16px;
            }

            .back-btn {
                font-size: 20px;
                left: 8px;
            }

            .container {
                width: 90%;
                padding: 15px;
            }

            .card {
                padding: 15px;
            }

            .card img {
                height: 150px;
            }

            .card-content p {
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <header>
        <a href="index.html" class="back-btn">←</a>
        <h1>Pantai</h1>
    </header>

    <div class="container">

        <!-- LOGO DI ATAS CARD AMED -->
        <div class="top-logo-container">
            <img src="logoRekomendasi.png" alt="Logo">
        </div>

        <!-- 1. Amed -->
        <div class="card">
            <img src="Amed.png" alt="Amed">
            <div class="card-content">
                <h2>Amed</h2>
                <p>Tidak memiliki jam tetap (buka setiap saat).</p>
                <p><b>Free Tiket.</b></p>
                <p>Amed Cocok untuk wisatawan Yang ingin bermain di pantai atau hanya
                    sekedar Menikmati Sunset/Sunrise.
                </p>
            </div>
        </div>

        <!-- 2. Jimbaran -->
        <div class="card">
            <img src="Jimbaran.png" alt="Jimbaran">
            <div class="card-content">
                <h2>Jimbaran</h2>
                <p>Tidak memiliki jam tetap (buka setiap saat).</p>
                <p><b>Free Tiket.</b></p>
                <p>Jimbaran Cocok untuk wisatawan Yang ingin bermain di pantai atau hanya
                    sekedar Menikmati Sunset/Sunrise.</p>
            </div>
        </div>

        <!-- 3. Pantai Melasti -->
        <div class="card">
            <img src="PantaiMelasti.png" alt="PantaiMelasti">
            <div class="card-content">
                <h2>Pantai Melasti</h2>
                <p><b>Jam Buka:</b> 08.00 - 23.59</p>
                <p><b>Tiket:</b> Dewasa 8.000 | Anak-anak 3.000</p>
                <p>perpaduan keindahan alamnya yang menawan, Menjadikan nya sebuah
                    destinasi wisata yang indah.</p>
            </div>
        </div>

        <!-- 4. Pantai Kuta -->
        <div class="card">
            <img src="PantaiKuta.png" alt="PantaiKuta">
            <div class="card-content">
                <h2>Pantai Kuta</h2>
                <p>Buka setiap saat.</p>
                <p><b>Free Tiket.</b></p>
                <p>Pantai Kuta Cocok untuk wisatawan Yang ingin bermain di pantai atau hanya sekedar Menikmati
                    Sunset/Sunrise.</p>
            </div>
        </div>

    </div>

</body>

</html>