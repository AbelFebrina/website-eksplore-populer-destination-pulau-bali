<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rekomendasi Destinasi</title>

    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: #4b6361;
        }

        /* HEADER */
        header {
            background-color: #4b6361;
            color: white;
            padding: 15px 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .logo {
            height: 40px;
            width: auto;
        }

        header h1 {
            font-size: 20px;
            margin: 0;
        }

        /* Tombol kembali */
        .back-btn {
            position: absolute;
            left: 10px;
            font-size: 25px;
            font-weight: bold;
            color: white;
            text-decoration: none;
        }

        /* Container putih tengah */
        .container {
            width: 60%;
            margin: 30px auto;
            background: white;
            border-radius: 15px;
            padding: 25px;
        }

        /*  SPACE + LOGO DI ATAS CARD AMED  */
        .top-logo-container {
            width: 100%;
            height: 60px;
            /* space kosong */
            position: relative;
            margin-bottom: -10px;
            /* biar card naik sedikit */
        }

        .top-logo-container img {
            position: absolute;
            right: 20px;
            top: 5px;
            height: 40px;
        }

        /* space */

        /* Kartu destinasi */
        .card {
            background-color: white;
            border-radius: 15px;
            width: 95%;
            box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.15);
            padding: 30px;
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }

        .card img {
            width: 30%;
            height: 180px;
            border-radius: 10px;
            object-fit: cover;
        }

        .card-content {
            width: 55%;
        }

        .card-content h2 {
            margin: 0;
            color: #3a5f5c;
        }

        .card-content p {
            margin: 5px 0;
            font-size: 14px;
        }

        .btn-detail {
            margin-top: 10px;
            background-color: #3f7f72;
            border: none;
            padding: 8px 18px;
            border-radius: 20px;
            color: white;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-detail:hover {
            background-color: #2c5f54;
        }

        /* RESPONSIVE */

        /* Tablet */
        @media (max-width: 768px) {
            .container {
                width: 85%;
                padding: 20px;
            }

            .card {
                flex-direction: column;
                text-align: center;
                padding: 20px;
            }

            .card img {
                width: 100%;
                height: 200px;
            }

            .card-content {
                width: 100%;
            }

            header h1 {
                font-size: 18px;
            }
        }

        /* HP */
        @media (max-width: 480px) {
            header h1 {
                font-size: 16px;
            }

            .back-btn {
                font-size: 20px;
                left: 8px;
            }

            .container {
                width: 90%;
                padding: 15px;
            }

            .card {
                padding: 15px;
            }

            .card img {
                height: 150px;
            }

            .card-content p {
                font-size: 13px;
            }

            .btn-detail {
                padding: 7px 15px;
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <header>
        <a href="index.html" class="back-btn">←</a>
        <h1>Rekomendasi Destinasi</h1>
    </header>
    <div class="container">

        <!-- LOGO DI ATAS CARD AMED -->
        <div class="top-logo-container">
            <img src="logoRekomendasi.png" alt="Logo">
        </div>


        <!-- 1. TANAH LOT -->
        <div class="card">
            <img src="rekomendasiTanahlot.png" alt="Tanah Lot">
            <div class="card-content">
                <h2>Tanah Lot</h2>
                <p><b>Jam Buka:</b> 06.00 - 19.00</p>
                <p><b>Harga Tiket:</b> Rp 20.000 - Rp 40.000</p>
                <p>Tanah Lot terkenal dengan keindahan pura di atas batu karang besar di tepi laut.</p>
                <button class="btn-detail">Peta Lokasi</button>
            </div>
        </div>

        <!-- 2. DANAU BERATAN -->
        <div class="card">
            <img src="rekomendasiDanauberatan.png" alt="Danau Beratan">
            <div class="card-content">
                <h2>Danau Beratan</h2>
                <p><b>Jam Buka:</b> 07.00 - 18.30</p>
                <p><b>Harga Tiket:</b> Rp 30.000 - Rp 50.000</p>
                <p>Danau Beratan Bedugul menyajikan udara sejuk dan pemandangan pura yang ikonik.</p>
                <button class="btn-detail">Peta Lokasi</button>
            </div>
        </div>

        <!-- 3. MONKEY FOREST -->
        <div class="card">
            <img src="rekomendasi.MonkeyForest.png" alt="Monkey Forest">
            <div class="card-content">
                <h2>Monkey Forest Ubud</h2>
                <p><b>Jam Buka:</b> 08.00 - 17.00</p>
                <p><b>Harga Tiket:</b> Rp 60.000</p>
                <p>Hutan wisata yang dihuni ratusan monyet dan menjadi ikon terkenal Ubud.</p>
                <button class="btn-detail">Peta Lokasi</button>
            </div>
        </div>

        <!-- 4. DESA PANGELIPURAN -->
        <div class="card">
            <img src="rekomenDesaPanglipuran.png" alt="Desa Penglipuran">
            <div class="card-content">
                <h2>Desa Penglipuran</h2>
                <p><b>Jam Buka:</b> 09.00 - 17.00</p>
                <p><b>Harga Tiket:</b> Rp 25.000</p>
                <p>Desa terbersih di dunia dengan nuansa adat Bali yang masih sangat terjaga.</p>
                <button class="btn-detail">Peta Lokasi</button>
            </div>
        </div>

        <!-- 5. PANTAI MELASTI -->
        <div class="card">
            <img src="rekomendPantaiMelasti.png" alt="Pantai Melasti">
            <div class="card-content">
                <h2>Pantai Melasti</h2>
                <p><b>Jam Buka:</b> 06.00 - 18.00</p>
                <p><b>Harga Tiket:</b> Rp 10.000</p>
                <p>Pantai berpasir putih dengan tebing kapur besar dan air biru jernih.</p>
                <button class="btn-detail">Peta Lokasi</button>
            </div>
        </div>

    </div>

</body>

</html>